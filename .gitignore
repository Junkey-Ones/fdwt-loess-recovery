# 原始数据与可重建产物
/data/raw/*
!/data/raw/README.md
/data/interim/*
!/data/interim/.gitkeep
/data/frozen/*
!/data/frozen/.gitkeep
/outputs/*
!/outputs/.gitkeep
/logs/*
!/logs/.gitkeep

# 本地 Python 环境、缓存和测试产物
/.venv/
/.conda/
__pycache__/
*.py[cod]
.pytest_cache/
.snakemake/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
/htmlcov/
.ipynb_checkpoints/

# 本机编辑器与操作系统文件
/.idea/
/.vscode/
desktop.ini
Thumbs.db
.DS_Store
*.tmp

# 本机凭据与环境覆盖
.env
.env.*
!.env.example
.cdsapirc
.netrc
_netrc
/metadata/local/
